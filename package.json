{
  "name": "blossom-server",
  "version": "1.0.0",
  "description": "Blossom Protocol Server on Cloudflare Workers with R2 storage",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev --env development",
    "deploy": "npm run deploy:production",
    "deploy:staging": "wrangler deploy --env development",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "test": "NODE_OPTIONS=--experimental-vm-modules node_modules/.bin/jest",
    "test:integration": "node scripts/integration-test.mjs"
  },
  "keywords": [
    "blossom",
    "nostr",
    "file-storage",
    "cloudflare-workers",
    "r2"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "esbuild": "0.28.1",
    "jest": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "miniflare": "5.20260903.0-alpha",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  }
}
